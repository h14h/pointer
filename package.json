{
  "name": "draftspa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "start": "bun scripts/serve.ts",
    "test": "bun test src/lib",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:all": "bun run test && bun run test:ui",
    "test:visual": "bunx playwright test",
    "test:visual:update": "bunx playwright test --update-snapshots",
    "lint": "eslint",
    "browse": "browse",
    "browse:doctor": "browse doctor",
    "browse:install-browser": "bunx playwright install chromium",
    "browse:local": "CHROME_PATH=$(node -e \"const { chromium } = require('@playwright/test'); console.log(chromium.executablePath())\") browse open http://localhost:3000 --local",
    "browse:projects": "browse cloud projects list",
    "browse:sessions": "browse cloud sessions list",
    "generate:nflverse-football-csv": "bun run scripts/generate-nflverse-football-csv.ts",
    "generate:public-dataset": "bun run scripts/generate-public-dataset.ts",
    "publish:public-datasets": "bun run scripts/publish-public-dataset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@base-ui/react": "^1.3.0",
    "@clerk/react": "6.7.3",
