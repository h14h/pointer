# Copy to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real hostnames, IPs, or secrets.

# --- Tidewave / remote dev (optional) ---
# Comma-separated hostnames allowed to load Next.js dev assets (/_next/*)
# when the browser origin is not localhost (e.g. Tidewave over Tailscale).
# Dev-only; ignored in production builds.
# Example: my-host.my-tailnet.ts.net,100.x.y.z,*.my-tailnet.ts.net
# ALLOWED_DEV_ORIGINS=

# Set to "true" to let Tidewave MCP accept non-localhost clients in development.
# Only enable on trusted networks (e.g. your tailnet). Default is localhost-only.
# TIDEWAVE_ALLOW_REMOTE=true
