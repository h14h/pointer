# Copy to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real hostnames, IPs, or secrets.

# --- Pro tier: Clerk auth + Convex cloud sync (optional) ---
# The app is fully functional (local-only, free) without these. Cloud features
# light up only when the keys are set. See docs/monetization.md for setup.
#
# Each public value has two names while Next.js and TanStack Start coexist:
# Next.js inlines NEXT_PUBLIC_*; the Start (Vite) build inlines VITE_*.
# Set both pairs to the same values so either build gets cloud mode.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# VITE_CONVEX_URL=https://<deployment>.convex.cloud
#
# Server-only (Next.js middleware; unused by the SPA Start build):
# CLERK_SECRET_KEY=sk_test_...

# --- Tidewave / remote dev (optional) ---
# Comma-separated hostnames allowed to load Next.js dev assets (/_next/*)
# when the browser origin is not localhost (e.g. Tidewave over Tailscale).
# Dev-only; ignored in production builds.
# Example: my-host.my-tailnet.ts.net,100.x.y.z,*.my-tailnet.ts.net
# ALLOWED_DEV_ORIGINS=

# Set to "true" to let Tidewave MCP accept non-localhost clients in development.
# Only enable on trusted networks (e.g. your tailnet). Default is localhost-only.
# TIDEWAVE_ALLOW_REMOTE=true
