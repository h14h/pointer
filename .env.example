# Copy to .env.local and fill in values as needed.
# .env.local is gitignored — never commit real hostnames, IPs, or secrets.

# --- Pro tier: Clerk auth + Polar checkout + Convex sync (optional) ---
# The app is fully functional (local-only, free) without these. Cloud features
# light up only when the keys are set. See docs/monetization.md for setup.
#
# These are PUBLIC values (publishable key / deployment URL / Polar product id)
# inlined into the client bundle by Vite at build time.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CONVEX_URL=https://<deployment>.convex.cloud
# VITE_POLAR_PRODUCT_ID=prod_...
#
# Convex dashboard env (not Vite, never in the browser bundle):
#   CLERK_FRONTEND_API_URL=https://<instance>.clerk.accounts.dev
#   POLAR_ACCESS_TOKEN=polar_oat_...
#   POLAR_PRODUCT_ID=prod_...
#   POLAR_WEBHOOK_SECRET=polar_whs_...
#   POLAR_SERVER=sandbox

# --- Tidewave / remote dev (optional) ---
# Comma-separated Host headers the Vite dev server should answer when the
# browser origin is not localhost (e.g. Tidewave over Tailscale). Wildcards
# use the `*.domain` form. Dev-only; ignored in production builds.
# Example: my-host.my-tailnet.ts.net,100.x.y.z,*.my-tailnet.ts.net
# ALLOWED_DEV_ORIGINS=

# Dev-server HTTPS: paths to a key/cert pair (e.g. the Tidewave-generated
# certs in ~/.config/tidewave/certs/). scripts/dev.ts also sets these when it
# sees the old Next-style --experimental-https-key/-cert flags.
# TIDEWAVE_HTTPS_KEY=/home/you/.config/tidewave/certs/host.key
# TIDEWAVE_HTTPS_CERT=/home/you/.config/tidewave/certs/host.crt

# Set to "true" to let Tidewave MCP accept non-localhost clients in development.
# Only enable on trusted networks (e.g. your tailnet). Default is localhost-only.
# TIDEWAVE_ALLOW_REMOTE=true

# Comma-separated browser origins allowed to call the Tidewave MCP endpoint.
# Include the origin where Tidewave Web is running, including its HTTPS port.
# TIDEWAVE_ALLOWED_ORIGINS=https://my-host.my-tailnet.ts.net:9833
